name: prompt-eval

# Trainee: copy this to .github/workflows/eval.yml inside your prompt library
# directory (work/library/.github/workflows/eval.yml).
# Adjust paths if you reorganized the harness.

on:
  pull_request:
    paths:
      - "prompts/**"
      - "goldens/**"
      - "harness/**"
  workflow_dispatch:

jobs:
  eval:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          pip install pyyaml jsonschema pydantic

      # Trainee: if you use API-based agent calls, set the secret here.
      # - name: Set up agent secret
      #   run: echo "ANTHROPIC_API_KEY=${{ secrets.ANTHROPIC_API_KEY }}" >> $GITHUB_ENV

      - name: Run eval harness (strict)
        run: python3 harness/run_eval.py --strict
