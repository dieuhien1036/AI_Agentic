    "file",
    "diff",
    "repo_root"
  ],
  "properties": {
    "file": {
      "type": "string",
      "minLength": 1
    },
    "diff": {
      "type": "string"
    },
    "repo_root": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
