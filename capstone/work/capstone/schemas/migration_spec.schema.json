{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "migration_spec.schema.json",
  "title": "Add-column migration spec (output of migration-request-parser)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operation", "table", "column", "type", "nullable", "default", "slug", "request", "assumptions"],
      "properties": {
        "status": {"const": "ok"},
        "operation": {"const": "add_column"},
        "table": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "column": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "type": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"},
        "default": {"type": ["string", "null"]},
        "slug": {"type": "string", "pattern": "^add_[a-z0-9_]+$"},
        "request": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "request", "questions"],
      "properties": {
        "status": {"const": "needs_clarification"},
        "request": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "partial": {"type": "object"}
      }
    }
  ]
}
