{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlannerResult",
  "type": "object",
  "required": [
    "files"
  ],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "lines_changed",
          "complexity",
          "sensitive"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "lines_changed": {
            "type": "integer",
            "minimum": 0
          },
          "complexity": {
            "type": "string",
            "enum": [
              "low",
              "med",
              "high"
            ]
          },
          "sensitive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
